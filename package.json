{
  "name": "translate-ter",
  "version": "2.0.1",
  "description": "Local-first desktop workflow for transcription, subtitle editing, and translation.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && electron-vite build",
    "package:electron": "node scripts/package-electron.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:deps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-webview2.ps1",
    "native:configure": "node scripts/build-native.mjs --configure-only",
    "native:build": "node scripts/build-native.mjs",
    "native:package": "node scripts/package-native.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "i18next": "^25.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "dev.translate-ter.app",
    "productName": "Translate-Ter",
    "files": [
      "out/**",
      "resources/whisper-manifest.json",
      "build/native/bin/translate-ter-backend*"
    ],
    "asarUnpack": [
      "build/native/bin/translate-ter-backend*"
    ],
    "extraResources": [
      {
        "from": "resources/whisper-manifest.json",
        "to": "whisper-manifest.json"
      },
      {
        "from": "resources/faster-whisper-runner.py",
        "to": "faster-whisper-runner.py"
      }
    ],
    "win": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}

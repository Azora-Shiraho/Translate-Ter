    "resolutionOrder": [
      "request.ffmpegPath/request.ffprobePath",
      "PATH"
    ],
    "sample": {
      "platforms": {
        "win32-x64": {
          "ffmpeg": "tools/ffmpeg/bin/ffmpeg.exe",

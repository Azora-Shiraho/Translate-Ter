{
  "manifestVersion": 1,
  "enabled": true,
  "note": "Windows x64 runtime is pinned to an official whisper.cpp release archive. Linux and macOS runtime assets remain unconfigured until verified distribution URLs and hashes are added.",
  "downloadPolicy": {
    "requiresUserConsent": true,
    "verifyBeforeInstall": true,
    "installRoot": "userData/runtime/whisper",
    "atomicInstall": true,
    "backendDownloadsAllowed": false

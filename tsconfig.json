{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["apps/desktop/src/shared/*"],
      "@main/*": ["apps/desktop/src/main/*"],
      "@renderer/*": ["apps/desktop/src/renderer/*"]
    }
  }
}
